# netv with AI Upscale (TensorRT super-resolution)
#
# This image includes everything needed for AI upscaling:
# - FFmpeg with TensorRT DNN backend
# - Python + torch + tensorrt for building engines
# - Auto-builds TensorRT engines on first start (GPU-specific)
#
# REQUIREMENTS:
#   - Docker BuildKit (DOCKER_BUILDKIT=1 or use docker buildx)
#   - NVIDIA GPU with 8GB+ VRAM recommended
#   - nvidia-container-toolkit installed on host
#
# Build:
#   docker build -f docker/Dockerfile.ai_upscale -t netv-ai-upscale .
#
# Run (engines are cached in volume):
#   docker run --gpus all -v netv-models:/models -p 8000:8000 netv-ai-upscale
#
# Note: First start takes ~2-3 minutes to build TensorRT engines for your GPU.
# Subsequent starts are instant (engines cached in /models volume).

ARG FFMPEG_IMAGE=ghcr.io/jvdillon/netv-ffmpeg:latest
FROM ${FFMPEG_IMAGE}

# Build metadata (passed from workflow, used for documentation/debugging)
ARG NVIDIA=cuda:13.0
ARG BASE_IMAGE=ubuntu:26.04

# Store build info as labels
LABEL org.opencontainers.image.description="netv with AI Upscale (TensorRT)"
LABEL ai.netv.cuda="${NVIDIA}"
LABEL ai.netv.base="${BASE_IMAGE}"

ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies.
# trtexec builds the TensorRT engines. Engines load only in the TensorRT release that
# built them, so it must be the exact libnvinfer10 release the FFmpeg base image ships
# (and FFmpeg's TensorRT backend loads); the base image keeps NVIDIA's repos configured.
RUN set -e; \
    apt-get update; \
    NVINFER_VERSION=$(dpkg-query -W -f='${Version}' libnvinfer10); \
    # libnvinfer-bin pins its siblings to its own release; apt would otherwise pick the newest.
    apt-get install -y --no-install-recommends \
        ca-certificates \
        gosu \
        "libnvinfer-bin=$NVINFER_VERSION" \
        "libnvinfer-lean10=$NVINFER_VERSION" \
        "libnvinfer-vc-plugin10=$NVINFER_VERSION" \
        "libnvinfer-dispatch10=$NVINFER_VERSION" \
        "libnvonnxparsers10=$NVINFER_VERSION"; \
    ln -s /usr/src/tensorrt/bin/trtexec /usr/local/bin/trtexec; \
    rm -rf /var/lib/apt/lists/*

# Python comes from uv, not the distro, so every base (22.04 ships 3.10) gets the same
# interpreter. The venv is first on PATH, so `python3`/`pip3` resolve to it everywhere.
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ARG PYTHON_VERSION=3.14
ENV UV_PYTHON_INSTALL_DIR=/opt/python \
    VIRTUAL_ENV=/opt/venv \
    PATH=/opt/venv/bin:$PATH
RUN uv venv --seed --python "$PYTHON_VERSION" /opt/venv && python3 --version

# App setup
WORKDIR /app

# Copy application files with verification
COPY pyproject.toml README.md ./
COPY netv/ netv/
COPY tools/ tools/

# Verify critical files exist
RUN test -f pyproject.toml || { echo "ERROR: pyproject.toml not found"; exit 1; } && \
    test -f tools/export-tensorrt.py || { echo "ERROR: export-tensorrt.py not found"; exit 1; }

# Install Python dependencies with minimum version constraints for compatibility.
# torch only exports the model to ONNX, on the CPU, so it is the CPU build: no CUDA
# runtime to mismatch the host driver, and no GPU-architecture floor.
# set -e: a failed install must fail the build (a trailing `|| true` used to mask it).
RUN set -e; \
    uv pip install --no-cache --index-url https://download.pytorch.org/whl/cpu 'torch>=2.1.0'; \
    uv pip install --no-cache \
        'onnx>=1.14.0' \
        'onnxconverter-common>=1.14' \
        'safetensors>=0.4' \
        '.[server]'; \
    python3 -c "import onnx, torch; assert torch.version.cuda is None, torch.version.cuda; print(f'Installed: torch={torch.__version__}, onnx={onnx.__version__}')"; \
    if ldd "$(command -v trtexec)" | grep 'not found'; then exit 1; fi

# Runtime config
EXPOSE 8000 8100

# Environment variables (see README for details)
ENV NETV_PORT=8000
ENV NETV_GATEWAY_PORT=8100
ENV NETV_HTTPS=""
ENV LOG_LEVEL=INFO
ENV NETV_DATA_DIR=/app/cache
ENV SR_ENGINE_DIR=/models

# Create non-root user
RUN groupadd --gid 10001 netv && \
    useradd --uid 10001 --gid 10001 --create-home netv

# Copy entrypoint and set permissions with validation
COPY docker/entrypoint-ai_upscale.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh && \
    test -x /app/entrypoint.sh || { echo "ERROR: entrypoint.sh not executable"; exit 1; }

# Create models directory with proper permissions (will be a volume mount point)
RUN mkdir -p /models && \
    chown netv:netv /models && \
    chmod 755 /models && \
    test -d /models && test -w /models || { echo "ERROR: /models not writable"; exit 1; }
VOLUME /models

# Healthcheck with improved error handling
# The long start period allows TensorRT engine compilation on first start.
HEALTHCHECK --interval=30s --timeout=10s --start-period=5m --retries=3 \
    CMD python3 -c "import os, urllib.request; gateway=os.environ.get('NETV_MODE') == 'gateway'; port=os.environ.get('NETV_GATEWAY_PORT', '8100') if gateway else os.environ.get('NETV_PORT', '8000'); path='/healthz' if gateway else '/'; r=urllib.request.urlopen(f'http://localhost:{port}{path}', timeout=5); exit(0 if r.status==200 else 1)" 2>/dev/null || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
